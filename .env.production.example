# ═══════════════════════════════════════════════
# .env.production — TEMPLATE untuk VPS
# Salin file ini ke VPS sebagai .env.production
# JANGAN commit file ini ke git!
# ═══════════════════════════════════════════════

APP_NAME="Cold Storage KUD Mino Saroyo"
APP_ENV=production
APP_KEY=                          # ← generate: php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://YOUR_VPS_IP        # ← ganti dengan domain/IP VPS

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Database ────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db                        # ← nama service docker-compose
DB_PORT=3306
DB_DATABASE=barulagi
DB_USERNAME=barulagi_user
DB_PASSWORD=GANTI_PASSWORD_DB     # ← ganti password kuat
DB_ROOT_PASSWORD=GANTI_ROOT_PASS  # ← untuk MySQL root

# ── Session & Cache ─────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis

# ── Redis ───────────────────────────────────────
REDIS_HOST=redis                  # ← nama service docker-compose
REDIS_PORT=6379
REDIS_PASSWORD=GANTI_REDIS_PASS   # ← ganti password kuat

# ── Queue ───────────────────────────────────────
QUEUE_CONNECTION=redis

# ── Filesystem ──────────────────────────────────
FILESYSTEM_DISK=public

# ── Mail (opsional) ─────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@minosaroyo.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── WhatsApp ────────────────────────────────────
# (diisi dari Filament admin panel)
